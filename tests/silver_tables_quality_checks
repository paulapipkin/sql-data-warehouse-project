
/*============================
checking silver.crm_cust_info
=============================*/

-- Checking Primary key: Nulls and Duplicates

SELECT
cst_id,
COUNT(*)
FROM silver.crm_cust_info
GROUP BY cst_id
HAVING COUNT(*)>1 OR cst_id IS NULL;

-- Check for unwanted spaces

SELECT cst_firstname
FROM silver.crm_cust_info
WHERE cst_firstname <> TRIM(cst_firstname);

-- Check Data Consistency

select distinct(cst_gndr) from silver.crm_cust_info;
select distinct(cst_material_status) from silver.crm_cust_info;


/*============================
checking silver.crm_prd_info
=============================*/

--Quality check for prod info table

-- Nulls and duplicates on ID
SELECT 
prd_id, 
COUNT(*)
FROM silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) >1 OR prd_id IS NULL;

--check for unwanted spaces

SELECT prd_nm
FROM silver.crm_prd_info
WHERE prd_nm != TRIM(prd_nm);


-- Check cost quality, nulls or negatives

SELECT prd_cost
FROM silver.crm_prd_info
WHERE prd_cost IS NULL OR prd_cost<0

-- Check quality for product line

SELECT DISTINCT prd_line
FROM silver.crm_prd_info

-- Date quality for Start and End date

SELECT * 
FROM silver.crm_prd_info
WHERE prd_end_dt < prd_start_dt

/*============================
checking silver.crm_sales_details
=============================*/

--Checking for data quality


-- unwanted spaces
select
sls_ord_num,
sls_prd_key,
sls_cust_id,
sls_order_dt,
sls_ship_dt,
sls_due_dt,
sls_sales,
sls_quantity,
sls_price

from silver.crm_sales_details
where sls_ord_num != TRIM(sls_ord_num);

--- check if shipdate < order date

select
sls_ord_num,
sls_prd_key,
sls_cust_id,
sls_order_dt,
sls_ship_dt,
sls_due_dt,
sls_sales,
sls_quantity,
sls_price

from silver.crm_sales_details
where sls_ship_dt < sls_order_dt OR sls_order_dt > sls_due_dt

--- looking for compatibility on prd_key

select
sls_ord_num,
sls_prd_key,
sls_cust_id,
sls_order_dt,
sls_ship_dt,
sls_due_dt,
sls_sales,
sls_quantity,
sls_price

from silver.crm_sales_details
where sls_prd_key NOT IN (SELECT prd_key from silver.crm_prd_info);

--- looking for compatibility on cust_id
select
sls_ord_num,
sls_prd_key,
sls_cust_id,
sls_order_dt,
sls_ship_dt,
sls_due_dt,
sls_sales,
sls_quantity,
sls_price

from silver.crm_sales_details
where sls_cust_id NOT IN (SELECT cst_id from silver.crm_cust_info);



--- looking for sales info logic Sales= qty*price and qty>0
select

sls_sales,
sls_quantity,
sls_price

from silver.crm_sales_details
where sls_sales != sls_quantity*sls_price 
OR sls_sales <=0 OR sls_price <=0 OR sls_quantity<=0
OR sls_sales IS NULL OR sls_price IS NULL OR sls_quantity IS NULL;


